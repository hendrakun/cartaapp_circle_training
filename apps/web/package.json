{
  "name": "@southneuhof/framework-web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "run-s type-check build-only",
    "preview": "vite preview",
    "test": "NODE_ENV=test vitest run --environment jsdom --root src/",
    "test:unit": "NODE_ENV=test vitest run --environment jsdom --root src/",
    "test:focused": "sh -c 'shift; NODE_ENV=test exec vitest run --environment jsdom --root src/ \"$@\"' --",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit --incremental -p tsconfig.vitest.json",
    "lint": "oxlint . --ignore-path ../../.gitignore && run-p lint:eslint format:check",
    "lint:focused": "sh -c 'if [ \"$1\" = \"--\" ]; then shift; fi; oxlint --quiet --ignore-path ../../.gitignore \"$@\" && eslint --quiet --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --ignore-path ../../.gitignore \"$@\" && exec oxfmt --check \"$@\"' --",
    "lint:eslint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --ignore-path ../../.gitignore",
    "lint:check": "pnpm run lint",
    "lint:fix": "oxlint . --fix --ignore-path ../../.gitignore && eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path ../../.gitignore && oxfmt '**/*.{vue,js,jsx,cjs,mjs,ts,tsx,cts,mts}'",
    "format": "oxfmt '**/*.{vue,js,jsx,cjs,mjs,ts,tsx,cts,mts}'",
    "format:check": "oxfmt --check '**/*.{vue,js,jsx,cjs,mjs,ts,tsx,cts,mts}'",
    "test:e2e": "sh -c 'if [ \"$1\" = \"--\" ]; then shift; fi; exec playwright test \"$@\"' --",
    "screenshots": "pnpm run test:e2e -- screenshots.spec.ts"
  },
  "dependencies": {
    "@southneuhof/api": "workspace:*",
    "@southneuhof/loom": "workspace:*",
    "@southneuhof/sdk": "workspace:*",
    "@southneuhof/utilities": "workspace:*",
    "@tinymce/tinymce-vue": "^6.0.1",
    "@vuepic/vue-datepicker": "^11.0.3",
    "@vueuse/core": "^12.5.0",
    "chart.js": "^4.4.5",
    "chartjs-chart-funnel": "^4.2.2",
    "chartjs-plugin-annotation": "^3.1.0",
    "chartjs-plugin-datalabels": "^2.2.0",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.5",
    "hono": "4.12.27",
    "html2pdf.js": "^0.10.3",
    "pinia": "^3.0.4",
    "qrcode.vue": "^3.5.0",
    "remixicon": "^4.6.0",
    "tailwind-merge": "^1.13.1",
    "tailwindcss-animate": "^1.0.7",
    "tinymce": "^7.2.1",
    "tippy.js": "^6.3.7",
    "uuid": "^11.0.2",
    "vaul-vue": "^0.3.0",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0",
    "vue-sonner": "^2.0.1",
    "vue-tippy": "^6.7.1",
    "vue-to-print": "^1.2.1",
    "vue3-google-map": "^0.15.0",
    "vue3-recaptcha2": "^1.8.0",
    "vuedraggable": "^4.1.0",
    "xlsx": "^0.18.5",
    "zod": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@rushstack/eslint-patch": "^1.3.0",
    "@types/google.maps": "^3.58.1",
    "@types/jsdom": "^20.0.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-typescript": "^11.0.3",
    "@vue/test-utils": "^2.3.2",
    "@vue/tsconfig": "0.9.1",
    "autoprefixer": "^10.4.14",
    "dotenv": "^16.1.4",
    "eslint": "^8.42.0",
    "eslint-plugin-oxlint": "1.79.0",
    "eslint-plugin-vue": "^9.14.1",
    "jsdom": "^20.0.3",
    "npm-run-all": "^4.1.5",
    "oxfmt": "0.65.0",
    "oxlint": "1.79.0",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.3.2",
    "typescript": "6.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.11"
  }
}
