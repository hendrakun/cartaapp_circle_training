# Templates only. Change API_PORT and the related API URLs in apps/api/.env.
API_PORT=5180
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/carta
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:5180
APP_ORIGIN=http://localhost:5181
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=example-bucket
S3_ACCESS_KEY=example-access-key
S3_SECRET_KEY=example-secret-key
CARTA_ADMIN_EMAIL=admin@example.com
CARTA_ADMIN_PASSWORD=demo-password
