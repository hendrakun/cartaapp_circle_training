{
  "$schema": "https://turbo.build/schema.json",
  // Sprindle type-check prepares its command and declaration files. API
  // type-check prepares the private route artifact. Declared outputs let a
  // cache hit restore the tools and types needed by dependent packages.
  "futureFlags": {
    // Lets --affected resolve the PR base ref from origin/ on GitHub
    // Actions checkouts where the base branch has no local ref.
    "githubActionsRemoteBaseRefFallback": true
  },
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-tooling/**", "dist-types/**", ".sprindle/**"]
    },
    "test": {
      "dependsOn": ["build", "^build"],
      "passThroughEnv": ["BETTER_AUTH_SECRET", "BETTER_AUTH_URL"],
      "outputs": []
    },
    "type-check": {
      "dependsOn": ["^type-check"],
      "outputs": ["dist-tooling/**", "dist-types/**", ".sprindle/**"]
    },
    "@southneuhof/framework-web#type-check": {
      "cache": false,
      "dependsOn": ["^type-check"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    }
  }
}
